---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cards from '../components/Cards.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
import { whatsappUrl } from '../lib/seo';
import { faqSchema } from '../lib/schema';

const services = (await getCollection('services', (e) => !e.data.noindex)).sort((a, b) => a.data.order - b.data.order);
const areas = (await getCollection('areas', (e) => !e.data.noindex)).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', (e) => !e.data.draft && !e.data.noindex))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const h = site.home;
---
<BaseLayout title={h.seoTitle} description={site.description} schema={[faqSchema(h.faqs)]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>{h.h1}</h1>
        <p class="lead">{h.intro}</p>
        <div class="btn-row">
          {site.whatsapp && <a class="btn btn-accent" href={whatsappUrl()} target="_blank" rel="noopener" data-loc="hero">WhatsApp for a quote</a>}
          <a class="btn btn-light" href={`tel:${site.phoneRaw}`} data-loc="hero">Call {site.phone}</a>
        </div>
        <ul class="trust">{h.trustPoints.map((p) => <li>{p}</li>)}</ul>
      </div>
      <LeadForm heading="Get a quote in minutes" />
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <h2>Our services</h2>
      <Cards items={services.map((s) => ({ href: `/${s.id}/`, name: s.data.name, summary: s.data.summary, price: s.data.price, image: s.data.image, imageAlt: s.data.imageAlt }))} />
    </div>
  </section>

  {areas.length > 0 && (
    <section class="section soft" id="areas">
      <div class="wrap">
        <h2>Areas we cover</h2>
        <Cards items={areas.map((a) => ({ href: `/${a.id}/`, name: a.data.name, summary: a.data.summary, image: a.data.image, imageAlt: a.data.imageAlt }))} />
      </div>
    </section>
  )}

  <Faq faqs={h.faqs} />

  {posts.length > 0 && (
    <section class="section soft">
      <div class="wrap">
        <h2>Latest guides</h2>
        <Cards items={posts.map((p) => ({ href: `/blog/${p.id}/`, name: p.data.title, summary: p.data.description, image: p.data.image, imageAlt: p.data.imageAlt }))} />
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
