---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
import { whatsappUrl } from '../lib/seo';
const a = site.address;
---
<BaseLayout
  title={`Contact ${site.name}`}
  description={`Call ${site.phone}, WhatsApp or send a booking request to ${site.name}. Desert safari and private tour bookings for guests in ${site.areaServed.join(', ')}.`}
  pageType="ContactPage"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
>
  <section class="section">
    <div class="wrap content-grid">
      <div class="prose">
        <h1>Contact us</h1>
        <p>Tell us your tour, date and number of guests. We reply on WhatsApp within minutes, 7 days a week.</p>
        <p><strong>Phone:</strong> <a href={`tel:${site.phoneRaw}`} data-loc="contact">{site.phone}</a></p>
        {site.whatsapp && <p><strong>WhatsApp:</strong> <a href={whatsappUrl()} target="_blank" rel="noopener" data-loc="contact">Chat with us</a></p>}
        {site.email && <p><strong>Email:</strong> <a href={`mailto:${site.email}`} data-loc="contact">{site.email}</a></p>}
        <p><strong>Based in:</strong> {a.city}, United Arab Emirates. Free pickup from any hotel or home in Dubai.</p>
        {site.mapsUrl && <p><a href={site.mapsUrl} target="_blank" rel="noopener">Open in Google Maps</a></p>}
      </div>
      <LeadForm />
    </div>
  </section>
</BaseLayout>
