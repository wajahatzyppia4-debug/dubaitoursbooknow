---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
---
<BaseLayout
  title={`About ${site.name}`}
  description={`${site.name} runs desert safaris and private city tours in Dubai and Abu Dhabi, with free hotel pickup and no payment needed to reserve.`}
  pageType="AboutPage"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]}
>
  <section class="section">
    <div class="wrap prose">
      <h1>About {site.name}</h1>
      <p>We are a Dubai tour team running evening desert safaris, private Land Cruiser safaris and private city tours of Dubai and Abu Dhabi. Our guests book straight with us, so the price they see is the price they pay, with pickup, dinner, drinks and shows included.</p>
      <h2>How we run our tours</h2>
      <ul>
        <li>Licensed, experienced desert drivers in well-maintained 4x4 Land Cruisers.</li>
        <li>Free pickup and drop-off from hotels and homes across Dubai.</li>
        <li>No deposit: reserve on WhatsApp and pay on the day.</li>
        <li>Friendly for families, couples, solo travellers and groups.</li>
      </ul>
      <h2>Where we pick up</h2>
      <p>Anywhere in Dubai, including Downtown, Dubai Marina, JBR, Palm Jumeirah, Deira, Bur Dubai, Al Barsha and Business Bay. Pickup from Sharjah and Abu Dhabi can be arranged on request.</p>
      <p><a href="/#packages">See our desert safari packages and prices</a>.</p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
