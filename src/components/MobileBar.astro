---
import { site } from '../config/site';
import { whatsappUrl } from '../lib/seo';
---
<div class="mobile-bar" role="navigation" aria-label="Quick contact">
  <a href={`tel:${site.phoneRaw}`} data-loc="mobile-bar">Call</a>
  {site.whatsapp && <a class="wa" href={whatsappUrl()} target="_blank" rel="noopener" data-loc="mobile-bar">WhatsApp</a>}
  <a class="quote" href="/contact/#quote">Get a quote</a>
</div>
