---
import { site } from '../config/site';
import { whatsappUrl } from '../lib/seo';
import Icon from './Icon.astro';
---
<div class="mobile-bar" role="navigation" aria-label="Quick contact">
  <a href={`tel:${site.phoneRaw}`} data-loc="mobile-bar"><Icon name="phone" size={18} />Call</a>
  {site.whatsapp && <a class="wa" href={whatsappUrl()} target="_blank" rel="noopener" data-loc="mobile-bar"><Icon name="whatsapp" size={18} />WhatsApp</a>}
  <a class="quote" href="/#book"><Icon name="calendar" size={18} />Book now</a>
</div>
