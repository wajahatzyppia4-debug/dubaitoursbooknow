---
/**
 * The Google Ads landing page for "desert safari Dubai" searches.
 * Packages and prices come from src/config/packages.ts.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
import { absUrl, whatsappUrl } from '../lib/seo';
import { faqSchema } from '../lib/schema';
import {
  aed,
  cityTours,
  includedInEverySafari,
  lowestPrice,
  privateSafaris,
  privateTiers,
  sharingSafaris,
  allBookable,
} from '../config/packages';
import heroImg from '../assets/images/desert-safari-dubai-hero.jpg';

const h = site.home;
const bookMsg = (name: string, price: number, unit: string) =>
  `Hi, I'd like to book the ${name} (${aed(price)} ${unit}). Date: ... Guests: ... Pickup: ...`;

const offersSchema = {
  '@type': 'ItemList',
  '@id': `${absUrl('/')}#tours`,
  name: 'Desert safari and Dubai tour packages',
  itemListElement: allBookable.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'TouristTrip',
      name: b.name,
      touristType: b.unit === 'per vehicle' ? 'Private groups and families' : 'Individuals, couples and families',
      provider: { '@id': `${site.url}/#business` },
      offers: {
        '@type': 'Offer',
        price: b.price,
        priceCurrency: 'AED',
        availability: 'https://schema.org/InStock',
        url: absUrl('/'),
        description: `${aed(b.price)} ${b.unit}`,
      },
    },
  })),
};

const timeline = [
  ['2:15 - 3:00 PM', 'Pickup', 'Your driver collects you from your hotel or home anywhere in Dubai in a 4x4 Land Cruiser.'],
  ['3:45 PM', 'Dune bashing', 'About 45 minutes of roller-coaster driving over the red dunes, as gentle or wild as your group wants.'],
  ['5:30 PM', 'Sunset stop', 'Photos on top of the dunes as the sun goes down, then sandboarding (and quad biking if booked).'],
  ['6:15 PM', 'Desert camp', 'Camel ride, henna, Arabic costume photos, shisha corner and unlimited soft drinks, tea and coffee.'],
  ['7:30 PM', 'Dinner and shows', 'BBQ buffet with grilled meats, salads and vegetarian dishes while the tanura, belly dance and fire shows play.'],
  ['9:30 PM', 'Drop-off', 'Back at your hotel with a camera full of photos.'],
];

const reasons = [
  ['Book direct, pay on the day', 'No deposit and no card details online. Reserve on WhatsApp and pay cash or card on the tour day.'],
  ['One clear price', 'The price you see includes pickup, dinner, drinks and shows. Nothing to pay at the camp unless you want extras.'],
  ['Licensed desert drivers', 'Experienced drivers in well-kept Land Cruisers with seat belts and roll cages, fully insured.'],
  ['Families welcome', 'Tell us who is coming and we keep the dune drive gentle for kids, grandparents or anyone who prefers it.'],
];
---
<BaseLayout
  title={h.seoTitle}
  description={site.description}
  image={heroImg}
  imageAlt="Red sand dunes at sunset on a desert safari near Dubai"
  schema={[offersSchema, faqSchema(h.faqs)]}
  exactTitle
>
  <section class="hero hero-photo">
    <Image
      class="hero-bg"
      src={heroImg}
      alt="Red sand dunes at sunset on an evening desert safari near Dubai"
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Evening desert safari · Free hotel pickup</p>
        <h1>{h.h1}</h1>
        <p class="lead">{h.intro}</p>
        <div class="btn-row">
          <a class="btn btn-wa" href={whatsappUrl()} target="_blank" rel="noopener" data-loc="hero">Book on WhatsApp</a>
          <a class="btn btn-light" href={`tel:${site.phoneRaw}`} data-loc="hero">Call now</a>
          <a class="btn btn-ghost-light" href="#book">Book online</a>
        </div>
        <ul class="trust">{h.trustPoints.map((p) => <li>{p}</li>)}</ul>
      </div>
      <aside class="price-card" aria-label="Price summary">
        <p class="from">From</p>
        <p class="big-price">{aed(lowestPrice)}<span> per person</span></p>
        <ul class="highlights">
          <li>Dune bashing in a 4x4 Land Cruiser</li>
          <li>Camel ride and sandboarding</li>
          <li>BBQ dinner with live shows</li>
          <li>Pickup and drop-off included</li>
        </ul>
        <a class="btn btn-accent btn-block" href="#packages">See all packages</a>
      </aside>
    </div>
  </section>

  <section class="strip" aria-label="Why guests book with us">
    <ul class="wrap strip-list">
      <li><strong>Free</strong> pickup anywhere in Dubai</li>
      <li><strong>AED 0</strong> to reserve</li>
      <li><strong>6 hours</strong> of desert fun</li>
      <li><strong>24/7</strong> WhatsApp support</li>
    </ul>
  </section>

  <section class="section" id="packages">
    <div class="wrap">
      <h2>Desert safari packages and prices</h2>
      <p class="section-lead">Shared safaris: you join other guests in a Land Cruiser (up to 6 per car). Prices are per person and include everything listed.</p>
      <ul class="packages">
        {sharingSafaris.map((t) => (
          <li class="package">
            {t.badge && <span class="badge">{t.badge}</span>}
            {t.image && <Image src={t.image} alt={t.imageAlt ?? t.name} width={600} height={360} loading="lazy" />}
            <div class="package-body">
              <h3>{t.name}</h3>
              <p class="package-price">{aed(t.price)} <span>{t.unit}</span></p>
              <p>{t.summary}</p>
              <ul class="highlights">{t.includes.map((i) => <li>{i}</li>)}</ul>
              <div class="package-cta">
                <a class="btn btn-wa" href={whatsappUrl(bookMsg(t.name, t.price, t.unit))} target="_blank" rel="noopener" data-loc="package" data-tour={t.name} data-value={t.price}>Book on WhatsApp</a>
                <a class="btn btn-ghost" href={`tel:${site.phoneRaw}`} data-loc="package" data-tour={t.name} data-value={t.price}>Call</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section soft" id="private">
    <div class="wrap">
      <h2>Private desert safari in your own Land Cruiser</h2>
      <p class="section-lead">The whole 4x4 and driver just for your group, with flexible pickup time. Prices are per vehicle, not per person.</p>
      <div class="private-grid">
        {privateSafaris.map((p) => (
          <div class="private-card">
            <h3>{p.group}</h3>
            <ul class="tier-list">
              {privateTiers.map((tier) => (
                <li>
                  <div>
                    <strong>{tier.name}</strong>
                    <small>{tier.note}</small>
                  </div>
                  <a
                    class="tier-price"
                    href={whatsappUrl(bookMsg(`${tier.name} for ${p.group}`, p[tier.key], 'per vehicle'))}
                    target="_blank"
                    rel="noopener"
                    data-loc="private"
                    data-tour={`${tier.name} (${p.group})`}
                    data-value={p[tier.key]}
                  >{aed(p[tier.key])}<span>Book →</span></a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="included">
    <div class="wrap two-col">
      <div>
        <h2>Included in every desert safari</h2>
        <ul class="highlights included">{includedInEverySafari.map((i) => <li>{i}</li>)}</ul>
        <p class="muted">Optional extras at the camp: longer quad bike or dune buggy rides, shisha and alcoholic drinks.</p>
      </div>
      <div>
        <h2>Your evening, hour by hour</h2>
        <p class="muted">Winter times shown. From May to September everything runs about an hour later to catch the sunset.</p>
        <ol class="timeline">
          {timeline.map(([time, title, text]) => (
            <li><span class="time">{time}</span><strong>{title}</strong><p>{text}</p></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section soft" id="city-tours">
    <div class="wrap">
      <h2>Private Dubai and Abu Dhabi city tours</h2>
      <p class="section-lead">Your own car, driver and guide with hotel pickup. One price per car for the whole group.</p>
      <ul class="packages">
        {cityTours.map((t) => (
          <li class="package">
            {t.badge && <span class="badge">{t.badge}</span>}
            <div class="package-body">
              <h3>{t.name}</h3>
              <p class="package-price">{aed(t.price)} <span>{t.unit}</span></p>
              <p>{t.summary}</p>
              <ul class="highlights">{t.includes.map((i) => <li>{i}</li>)}</ul>
              <div class="package-cta">
                <a class="btn btn-wa" href={whatsappUrl(bookMsg(t.name, t.price, t.unit))} target="_blank" rel="noopener" data-loc="city-tour" data-tour={t.name} data-value={t.price}>Book on WhatsApp</a>
                <a class="btn btn-ghost" href={`tel:${site.phoneRaw}`} data-loc="city-tour" data-tour={t.name} data-value={t.price}>Call</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Why book directly with us</h2>
      <ul class="reasons">
        {reasons.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section soft" id="book">
    <div class="wrap content-grid book-grid">
      <div class="prose">
        <h2>Book your desert safari now</h2>
        <p>Send the form and we reply on WhatsApp, usually within a few minutes, to confirm your pickup time. Prefer to talk? Call <a href={`tel:${site.phoneRaw}`} data-loc="book">{site.phone}</a> or <a href={whatsappUrl()} target="_blank" rel="noopener" data-loc="book">message us on WhatsApp</a>.</p>
        <h3>What happens next</h3>
        <ol>
          <li>We confirm your seats and pickup time on WhatsApp.</li>
          <li>Your driver messages you on the day before arriving.</li>
          <li>Enjoy the desert and pay in cash or by card on the day.</li>
        </ol>
        <h3>Good to know</h3>
        <ul>
          <li>Wear comfortable clothes and closed shoes; bring sunglasses and a light jacket in winter.</li>
          <li>Dune bashing is not recommended for pregnant guests, babies under 3 or anyone with back or heart problems. Tell us and we will skip it.</li>
          <li>Safaris run every day of the year. Morning and overnight safaris are available on request.</li>
          <li>Free cancellation up to 24 hours before pickup.</li>
        </ul>
      </div>
      <div class="sticky"><LeadForm /></div>
    </div>
  </section>

  <Faq faqs={h.faqs} />

  <CtaBand
    heading="Weekend seats fill up fast"
    text="Reserve today for free and pay on the day of your safari."
    message={site.whatsappMessage}
  />
</BaseLayout>
