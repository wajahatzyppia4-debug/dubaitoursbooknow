---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
---
<BaseLayout
  title={`About ${site.name}`}
  description={`Learn about ${site.name}: who we are, how we work and why clients across ${site.areaServed.join(', ')} trust us.`}
  pageType="AboutPage"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]}
>
  <section class="section">
    <div class="wrap prose">
      <h1>About {site.name}</h1>
      <p>{site.description}</p>
      <h2>Why clients choose us</h2>
      <ul>{site.home.trustPoints.map((p) => <li>{p}</li>)}</ul>
      <h2>Where we work</h2>
      <p>We serve customers across {site.areaServed.join(', ')}.</p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
