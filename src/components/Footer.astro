---
import { site } from '../config/site';
import { whatsappUrl } from '../lib/seo';
import { aed, cityTours, sharingSafaris } from '../config/packages';
const socials = Object.entries(site.social).filter(([, url]) => url);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">{site.name}</p>
      <p>{site.tagline}</p>
      <address>
        {site.address.city}, United Arab Emirates<br />
        <a href={`tel:${site.phoneRaw}`} data-loc="footer">{site.phone}</a><br />
        {site.email && <a href={`mailto:${site.email}`} data-loc="footer">{site.email}</a>}
        {site.whatsapp && <><br /><a href={whatsappUrl()} target="_blank" rel="noopener" data-loc="footer">WhatsApp us</a></>}
      </address>
      {site.mapsUrl && <p><a href={site.mapsUrl} target="_blank" rel="noopener">Find us on Google Maps</a></p>}
    </div>
    <div>
      <p class="footer-head">Desert safaris</p>
      <ul>
        {sharingSafaris.map((t) => <li><a href="/#packages">{t.name} · {aed(t.price)}</a></li>)}
        <li><a href="/#private">Private Land Cruiser safari</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-head">City tours</p>
      <ul>{cityTours.map((t) => <li><a href="/#city-tours">{t.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer-head">Company</p>
      <ul>
        <li><a href="/about/">About us</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/booking-terms/">Booking and cancellation</a></li>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
      </ul>
      {socials.length > 0 && (
        <ul class="socials">{socials.map(([name, url]) => <li><a href={url} target="_blank" rel="noopener me">{name}</a></li>)}</ul>
      )}
    </div>
  </div>
  <p class="wrap copyright">© {year} {site.name}. All rights reserved.</p>
</footer>
