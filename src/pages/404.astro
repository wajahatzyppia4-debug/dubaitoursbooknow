---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="Sorry, this page does not exist. Use the menu or go back to the homepage to find what you need." noindex>
  <section class="section">
    <div class="wrap narrow prose">
      <h1>Page not found</h1>
      <p>The page you were looking for has moved or does not exist.</p>
      <p><a class="btn btn-accent" href="/">Go to the homepage</a></p>
    </div>
  </section>
</BaseLayout>
